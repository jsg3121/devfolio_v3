---
import { RESUME_DOCUMENTS } from '@/lib/constants/resume';

const contactLinks = [
  { label: 'Email', href: 'mailto:xodm95@gmail.com', description: 'xodm95@gmail.com' },
  {
    label: 'GitHub',
    href: 'https://github.com/jsg3121',
    description: 'github.com/jsg3121',
    external: true,
  },
];
---

<section class="py-20 md:py-28 bg-gray-50 dark:bg-slate-800/50">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16">
      <!-- Resume -->
      <div id="documents" class="scroll-mt-24" data-reveal="up">
        <h2
          class="text-sm font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-6"
        >
          Resume
        </h2>
        <p class="text-base text-gray-600 dark:text-slate-300 leading-relaxed mb-6">
          이력서와 포트폴리오를 PDF로 다운로드하실 수 있습니다.
        </p>
        <ul class="space-y-4">
          {
            RESUME_DOCUMENTS.map((document) => (
              <li>
                <a
                  href={document.href}
                  download={document.fileName}
                  class="group flex items-center justify-between gap-4 p-3 -mx-3 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors"
                >
                  <div>
                    <p class="text-sm font-medium text-gray-900 dark:text-slate-100">
                      {document.label}
                      <span class="ml-2 text-[10px] font-semibold text-gray-400 dark:text-slate-500 align-middle">
                        PDF
                      </span>
                    </p>
                    <p class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">
                      {document.description}
                    </p>
                  </div>
                  <svg
                    class="w-4 h-4 text-gray-300 dark:text-slate-600 shrink-0 transition-all group-hover:text-gray-500 dark:group-hover:text-slate-400 group-hover:translate-y-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div data-reveal="up" data-reveal-delay="100">
        <h2
          class="text-sm font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-6"
        >
          Contact
        </h2>
        <p class="text-base text-gray-600 dark:text-slate-300 leading-relaxed mb-6">
          더 많은 개발 이야기를 하고 싶으시다면 편하게 연락 주세요.
        </p>
        <ul class="space-y-4">
          {
            contactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover-arrow group flex items-center justify-between p-3 -mx-3 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors"
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <div>
                    <p class="text-sm font-medium text-gray-900 dark:text-slate-100">
                      {link.label}
                    </p>
                    <p class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">
                      {link.description}
                    </p>
                  </div>
                  <svg
                    class="w-4 h-4 text-gray-300 dark:text-slate-600 arrow-icon shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
