---
import { getAllArticles } from '@/lib/content/articles';

const articles = await getAllArticles();
---

<section class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-6">
    <header class="mb-16" data-reveal="up">
      <h1
        class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-slate-100 tracking-tight mb-4"
      >
        Articles
      </h1>
      <p class="text-lg text-gray-500 dark:text-slate-400 max-w-2xl leading-relaxed">
        개발 과정에서 겪은 기술적 경험과 인사이트를 정리합니다.
      </p>
    </header>

    <div class="space-y-6">
      {
        articles.map((article, index) => (
          <a
            href={`/articles/${article.data.slug}`}
            class="hover-lift group block bg-white dark:bg-slate-800 rounded-xl p-6 md:p-8 border border-gray-200 dark:border-slate-700"
            data-reveal="up"
            data-reveal-delay={String(index * 100)}
          >
            <div class="flex flex-wrap gap-1.5 mb-3">
              {article.data.categories.map((category: string) => (
                <span class="text-xs px-2 py-0.5 bg-gray-100 dark:bg-slate-700 text-gray-500 dark:text-slate-400 rounded-full">
                  {category}
                </span>
              ))}
            </div>
            <h2 class="text-xl md:text-2xl font-semibold text-gray-900 dark:text-slate-100 mb-3 group-hover:text-gray-600 dark:group-hover:text-slate-300 transition-colors">
              {article.data.title}
            </h2>
            <p class="text-base text-gray-500 dark:text-slate-400 leading-relaxed mb-4">
              {article.data.summary}
            </p>
            <div class="flex items-center justify-between">
              <div class="flex flex-wrap gap-1.5">
                {article.data.tags.map((tag: string) => (
                  <span class="text-xs px-2 py-0.5 bg-gray-50 dark:bg-slate-700/50 text-gray-400 dark:text-slate-500 rounded">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex shrink-0 items-center gap-1 text-sm text-gray-400 dark:text-slate-500 group-hover:text-gray-600 dark:group-hover:text-slate-300 transition-colors">
                <span>읽기</span>
                <svg
                  class="w-3.5 h-3.5 arrow-icon"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
