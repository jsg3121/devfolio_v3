---
import { getAllCareers } from '@/lib/content/career';
const careers = await getAllCareers();

const formatDate = (date: Date): string => {
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
};
---

<section class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-6">
    <h2
      class="text-sm font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-16"
      data-reveal="up"
    >
      Career Timeline
    </h2>

    <div class="career-timeline relative">
      <!-- 타임라인 세로선 (배경) -->
      <div
        class="timeline-track absolute left-4 md:left-6 top-0 bottom-0 w-px bg-gray-200 dark:bg-slate-700"
        aria-hidden="true"
      >
      </div>
      <!-- 타임라인 세로선 (스크롤 진행) -->
      <div
        class="timeline-progress absolute left-4 md:left-6 top-0 w-px bg-gray-900 dark:bg-slate-200 origin-top"
        aria-hidden="true"
      >
      </div>

      <ol class="relative space-y-16 md:space-y-20">
        {
          careers.map((career) => {
            return (
              <li class="timeline-item pl-12 md:pl-16">
                {/* 타임라인 노드 */}
                <div class="timeline-node absolute left-2.5 md:left-4 w-3 h-3 rounded-full border-2 mt-2" />

                <article>
                  <header class="mb-4">
                    <div class="flex flex-col md:flex-row md:items-baseline md:gap-4 mb-1">
                      <h3 class="text-xl md:text-2xl font-semibold text-gray-900 dark:text-slate-100">
                        {career.data.company}
                      </h3>
                      {career.data.isCurrent && (
                        <span class="text-xs px-2 py-0.5 bg-gray-900 dark:bg-slate-200 text-white dark:text-slate-900 rounded-full w-fit">
                          현재
                        </span>
                      )}
                    </div>
                    <p class="text-base text-gray-500 dark:text-slate-400">{career.data.role}</p>
                    <p class="text-sm text-gray-400 dark:text-slate-500 mt-1">
                      {formatDate(career.data.startDate)} ~{' '}
                      {career.data.endDate ? formatDate(career.data.endDate) : '현재'}
                    </p>
                  </header>

                  <p class="text-base text-gray-600 dark:text-slate-300 leading-relaxed mb-5">
                    {career.data.summary}
                  </p>

                  {/* 주요 성과 */}
                  <ul class="space-y-1.5 mb-5">
                    {career.data.highlights.map((highlight: string) => (
                      <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-slate-300">
                        <span class="text-gray-300 dark:text-slate-600 mt-0.5 shrink-0">—</span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>

                  {/* 기술 스택 */}
                  <div class="flex flex-wrap gap-1.5 mb-5">
                    {career.data.skills.map((skill: string) => (
                      <span class="text-xs px-2 py-0.5 bg-gray-100 dark:bg-slate-700 text-gray-500 dark:text-slate-400 rounded-full">
                        {skill}
                      </span>
                    ))}
                  </div>
                </article>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initTimeline = () => {
    // 이전 ScrollTrigger 인스턴스 정리
    ScrollTrigger.getAll().forEach((st) => st.kill());

    const timeline = document.querySelector('.career-timeline');
    if (!timeline) return;

    const progress = timeline.querySelector('.timeline-progress') as HTMLElement;
    const items = timeline.querySelectorAll<HTMLElement>('.timeline-item');
    const nodes = timeline.querySelectorAll<HTMLElement>('.timeline-node');

    if (!progress) return;

    // 타임라인 세로선 스크롤 진행 애니메이션
    gsap.fromTo(
      progress,
      { scaleY: 0 },
      {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: timeline,
          start: 'top 80%',
          end: 'bottom 20%',
          scrub: 0.3,
        },
      },
    );

    // 각 타임라인 아이템 등장
    items.forEach((item) => {
      gsap.set(item, { opacity: 0, x: -20 });

      ScrollTrigger.create({
        trigger: item,
        start: 'top 85%',
        onEnter: () => {
          gsap.to(item, {
            opacity: 1,
            x: 0,
            duration: 0.6,
            ease: 'power2.out',
          });
        },
        onRefresh: (self) => {
          // 새로고침 시 이미 뷰포트를 지난 아이템은 즉시 표시
          if (self.progress > 0) {
            gsap.set(item, { opacity: 1, x: 0 });
          }
        },
      });
    });

    // 노드 활성화
    nodes.forEach((node) => {
      ScrollTrigger.create({
        trigger: node,
        start: 'top 80%',
        onEnter: () => {
          node.classList.add('timeline-node-active');
        },
        onRefresh: (self) => {
          if (self.progress > 0) {
            node.classList.add('timeline-node-active');
          }
        },
      });
    });

    // 레이아웃 계산 완료 후 ScrollTrigger 위치 갱신
    ScrollTrigger.refresh();
  };

  document.addEventListener('astro:page-load', initTimeline);
</script>

<style>
  .timeline-progress {
    will-change: transform;
  }

  .timeline-node {
    border-color: #d1d5db; /* gray-300 */
    background-color: #ffffff;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  :global(.dark) .timeline-node {
    border-color: #475569; /* slate-600 */
    background-color: #0f172a; /* slate-900 */
  }

  .timeline-node-active {
    border-color: #111827;
    background-color: #111827;
  }

  :global(.dark) .timeline-node-active {
    border-color: #e2e8f0;
    background-color: #e2e8f0;
  }
</style>
