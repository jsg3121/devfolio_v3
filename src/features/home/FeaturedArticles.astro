---
import { getFeaturedArticles } from '@/lib/content/articles';

const articles = await getFeaturedArticles();
---

<section class="py-20 md:py-28 bg-gray-50 dark:bg-slate-800/50">
  <div class="max-w-5xl mx-auto px-6">
    <h2
      class="text-sm font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-12"
      data-reveal="up"
    >
      Articles
    </h2>
    <div class="grid md:grid-cols-2 gap-6">
      {
        articles.map((article, index) => (
          <a
            href={`/articles/${article.data.slug}`}
            class="min-h-40 hover-lift block group bg-white dark:bg-slate-800 rounded-xl p-6 border border-gray-100 dark:border-slate-700"
            data-reveal="up"
            data-reveal-delay={String(index * 100)}
            transition:name={`article-card-${article.data.slug}`}
          >
            <div class="w-full h-5 flex flex-wrap gap-1.5 mb-2">
              {article.data.categories.map((category: string) => (
                <span class="text-xs px-2 py-0.5 bg-gray-100 dark:bg-slate-700 text-gray-500 dark:text-slate-400 rounded-full">
                  {category}
                </span>
              ))}
            </div>
            <h3 class="min-h-[calc(100%-3.5rem)] text-lg font-semibold text-gray-900 dark:text-slate-100 mb-2 group-hover:text-gray-600 dark:group-hover:text-slate-300 transition-colors">
              {article.data.title}
            </h3>
            <div class="w-full h-5 flex items-center justify-between">
              <div class="flex flex-wrap gap-1.5">
                {article.data.tags.slice(0, 3).map((tag: string) => (
                  <span class="text-xs px-2 py-0.5 bg-gray-50 dark:bg-slate-700/50 text-gray-400 dark:text-slate-500 rounded">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex items-center shrink-0 gap-1 text-sm text-gray-400 dark:text-slate-500 group-hover:text-gray-600 dark:group-hover:text-slate-300 transition-colors">
                <span>읽기</span>
                <svg
                  class="w-3.5 h-3.5 arrow-icon"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
