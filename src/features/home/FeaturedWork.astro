---
import { getFeaturedCareers } from '@/lib/content/career';

const careers = await getFeaturedCareers();

const formatDate = (date: Date): string => {
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
};
---

<section class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-sm font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-12" data-reveal="up">
      Featured Work
    </h2>
    <div class="space-y-12">
      {careers.map((career, index) => (
        <div
          class="featured-work-item border-l-2 border-gray-200 dark:border-slate-700 pl-6 md:pl-8"
          data-reveal="left"
          data-reveal-delay={String(index * 150)}
        >
          <div class="flex flex-col md:flex-row md:items-baseline md:gap-4 mb-3">
            <h3 class="text-xl md:text-2xl font-semibold text-gray-900 dark:text-slate-100">
              {career.data.company}
            </h3>
            <span class="text-sm text-gray-400 dark:text-slate-500">
              {formatDate(career.data.startDate)} ~ {career.data.endDate ? formatDate(career.data.endDate) : '현재'}
            </span>
          </div>
          <p class="text-base text-gray-500 dark:text-slate-400 mb-3">{career.data.role}</p>
          <p class="text-base text-gray-600 dark:text-slate-300 leading-relaxed mb-4">{career.data.summary}</p>
          <div class="flex flex-wrap gap-2">
            {career.data.domains.map((domain: string) => (
              <span class="text-xs px-2.5 py-1 bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400 rounded-full">{domain}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="mt-12" data-reveal="up" data-reveal-delay="200">
      <a
        href="/work"
        class="hover-arrow inline-flex items-center gap-2 text-sm font-medium text-gray-900 dark:text-slate-100 hover:text-gray-600 dark:hover:text-slate-300 transition-colors"
      >
        전체 경력 보기
        <svg class="w-4 h-4 arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
