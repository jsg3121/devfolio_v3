---
interface Metric {
  value: string;
  numericValue: number;
  suffix: string;
  prefix: string;
  label: string;
}

const metrics: Metric[] = [
  { value: '7', numericValue: 7, suffix: '년차', prefix: '', label: '프론트엔드 경력' },
  { value: '3~4', numericValue: 4, suffix: '억 원', prefix: '연 ', label: 'CDN 비용 절감' },
  { value: '10', numericValue: 10, suffix: '배', prefix: '', label: 'HTML 로드 개선' },
  { value: '58', numericValue: 58, suffix: '%', prefix: '', label: '페이지 로드 단축' },
];
---

<section class="py-20 md:py-28 bg-gray-50 dark:bg-slate-800/50">
  <div class="max-w-5xl mx-auto px-6">
    <h2
      class="text-sm font-medium text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-12"
      data-reveal="up"
    >
      Key Metrics
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-1 md:gap-4">
      {
        metrics.map((metric, index) => (
          <div class="metric-item" data-reveal="up" data-reveal-delay={String(index * 100)}>
            <p
              class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-2"
              data-countup={String(metric.numericValue)}
              data-countup-prefix={metric.prefix}
              data-countup-suffix={metric.suffix}
              data-countup-display={metric.value}
            >
              {metric.prefix}
              {metric.value}
              {metric.suffix}
            </p>
            <p class="text-sm md:text-base text-gray-500 dark:text-slate-400">{metric.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const COUNTUP_DURATION = 1500;
  const COUNTUP_THRESHOLD = 0.3;

  const easeOutQuart = (t: number): number => 1 - Math.pow(1 - t, 4);

  const animateCountUp = (el: HTMLElement) => {
    const target = Number(el.dataset.countup);
    const prefix = el.dataset.countupPrefix ?? '';
    const suffix = el.dataset.countupSuffix ?? '';
    const displayValue = el.dataset.countupDisplay ?? String(target);
    const isInteger = Number.isInteger(target);

    let start: number | null = null;

    const step = (timestamp: number) => {
      if (start === null) start = timestamp;
      const elapsed = timestamp - start;
      const progress = Math.min(elapsed / COUNTUP_DURATION, 1);
      const easedProgress = easeOutQuart(progress);

      const current = easedProgress * target;
      const formatted = isInteger ? Math.round(current) : current.toFixed(1);

      el.textContent = `${prefix}${progress >= 1 ? displayValue : formatted}${suffix}`;

      if (progress < 1) {
        requestAnimationFrame(step);
      }
    };

    requestAnimationFrame(step);
  };

  const initCountUp = () => {
    const elements = document.querySelectorAll<HTMLElement>('[data-countup]');
    if (elements.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCountUp(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: COUNTUP_THRESHOLD },
    );

    elements.forEach((el) => observer.observe(el));
  };

  document.addEventListener('astro:page-load', initCountUp);
</script>
