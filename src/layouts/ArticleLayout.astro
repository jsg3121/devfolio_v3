---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { MetaProps } from '@/lib/seo/meta';

interface Props extends MetaProps {
  jsonLd?: string[];
}

const { ...seoProps } = Astro.props;
---

<BaseLayout {...seoProps}>
  <Header />
  <main class="py-20 md:py-28">
    <article class="prose-content max-w-5xl mx-auto px-6">
      <slot />
    </article>
  </main>
  <Footer />
</BaseLayout>
