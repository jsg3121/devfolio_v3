---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import ImageSlider from '@/components/common/ImageSlider.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { SITE } from '@/lib/constants/site';
import { buildWebPageJsonLd, buildBreadcrumbJsonLd } from '@/lib/seo/jsonld';
import { buildCanonicalUrl } from '@/lib/seo/meta';

export const getStaticPaths = (async () => {
  const projects = await getCollection('sideProjects');
  return projects.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props as Props;
const { Content } = await render(entry);

const projectUrl = buildCanonicalUrl(`/side-projects/${entry.data.slug}`);

const statusLabel: Record<string, { text: string; className: string }> = {
  active: {
    text: 'Active',
    className: 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400',
  },
  paused: {
    text: 'Paused',
    className: 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400',
  },
  archived: {
    text: 'Archived',
    className: 'bg-gray-100 dark:bg-slate-700 text-gray-500 dark:text-slate-400',
  },
};

const status = statusLabel[entry.data.status];

const formatDate = (date: Date): string => {
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
};
---

<ArticleLayout
  title={`${entry.data.title} | 장선규`}
  description={entry.data.description}
  canonicalUrl={projectUrl}
  jsonLd={[
    buildWebPageJsonLd({
      title: entry.data.title,
      description: entry.data.description,
      url: projectUrl,
    }),
    buildBreadcrumbJsonLd([
      { name: 'Home', url: SITE.url },
      { name: 'Side Projects', url: buildCanonicalUrl('/side-projects') },
      { name: entry.data.title, url: projectUrl },
    ]),
  ]}
>
  <header class="mb-12 md:mb-16">
    <div class="flex items-center gap-3 mb-4">
      <span class:list={['text-xs px-2.5 py-1 rounded-full font-medium', status.className]}>
        {status.text}
      </span>
      <span class="text-sm text-gray-400 dark:text-slate-500">
        {formatDate(entry.data.startedAt)}{
          entry.data.updatedAt ? ` — ${formatDate(entry.data.updatedAt)}` : ''
        }
      </span>
    </div>
    <h1
      class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-slate-100 tracking-tight mb-4 leading-tight"
    >
      {entry.data.title}
    </h1>
    <p class="text-lg text-gray-500 dark:text-slate-400 leading-relaxed mb-6">
      {entry.data.description}
    </p>
    <div class="flex flex-wrap gap-1.5 mb-6">
      {
        entry.data.skills.map((skill: string) => (
          <span class="text-xs px-2.5 py-1 bg-gray-100 dark:bg-slate-700 text-gray-500 dark:text-slate-400 rounded-full">
            {skill}
          </span>
        ))
      }
    </div>
    <div class="flex items-center gap-4">
      {
        entry.data.repositoryUrl &&
          entry.data.repositoryUrl.map((url: string, index: number) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-gray-400 dark:text-slate-500 hover:text-gray-900 dark:hover:text-slate-100 transition-colors underline underline-offset-2"
            >
              {entry.data.repositoryUrl!.length > 1 ? `GitHub (${index + 1})` : 'GitHub'}
            </a>
          ))
      }
      {
        entry.data.projectUrl && (
          <a
            href={entry.data.projectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-gray-400 dark:text-slate-500 hover:text-gray-900 dark:hover:text-slate-100 transition-colors underline underline-offset-2"
          >
            Live
          </a>
        )
      }
      {
        entry.data.links &&
          entry.data.links.map((link, index: number) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-gray-400 dark:text-slate-500 hover:text-gray-900 dark:hover:text-slate-100 transition-colors underline underline-offset-2"
            >
              {link.label}
            </a>
          ))
      }
    </div>
  </header>
  {entry.data.images && entry.data.images.length > 0 && <ImageSlider images={entry.data.images} />}

  <Content />
</ArticleLayout>
