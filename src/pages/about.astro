---
import PageLayout from '@/layouts/PageLayout.astro';
import AboutIntro from '@/features/about/AboutIntro.astro';
import WorkStyle from '@/features/about/WorkStyle.astro';
import TechStack from '@/features/about/TechStack.astro';
import ResumeContact from '@/features/about/ResumeContact.astro';
import { SITE } from '@/lib/constants/site';
import { buildWebPageJsonLd, buildBreadcrumbJsonLd } from '@/lib/seo/jsonld';
import { buildCanonicalUrl } from '@/lib/seo/meta';

const title = 'About | 장선규';
const description =
  '프론트엔드 엔지니어 장선규 소개. 일하는 방식, 기술 스택, 이력서 다운로드, 연락처.';
---

<PageLayout
  title={title}
  description={description}
  jsonLd={[
    buildWebPageJsonLd({
      title,
      description,
      url: buildCanonicalUrl('/about'),
    }),
    buildBreadcrumbJsonLd([
      { name: 'Home', url: SITE.url },
      { name: 'About', url: buildCanonicalUrl('/about') },
    ]),
  ]}
>
  <AboutIntro />
  <WorkStyle />
  <TechStack />
  <ResumeContact />
</PageLayout>
