---
import PageLayout from '@/layouts/PageLayout.astro';
import Hero from '@/features/home/Hero.astro';
import KeyMetrics from '@/features/home/KeyMetrics.astro';
import FeaturedWork from '@/features/home/FeaturedWork.astro';
import FeaturedArticles from '@/features/home/FeaturedArticles.astro';
import ContactCTA from '@/features/home/ContactCTA.astro';
import { SITE } from '@/lib/constants/site';
import { buildPersonJsonLd, buildWebSiteJsonLd, buildWebPageJsonLd } from '@/lib/seo/jsonld';
import { buildCanonicalUrl } from '@/lib/seo/meta';
---

<PageLayout
  title={SITE.title}
  description={SITE.description}
  jsonLd={[
    buildPersonJsonLd(),
    buildWebSiteJsonLd(),
    buildWebPageJsonLd({
      title: SITE.title,
      description: SITE.description,
      url: buildCanonicalUrl('/'),
    }),
  ]}
>
  <Hero />
  <KeyMetrics />
  <FeaturedWork />
  <FeaturedArticles />
  <ContactCTA />
</PageLayout>
