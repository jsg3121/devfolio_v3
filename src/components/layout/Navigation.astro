---
import { NAV_ITEMS } from '@/lib/constants/navigation';
import ThemeToggle from '@/components/common/ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const isActive = (href: string): boolean => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<nav class="flex items-center justify-between w-full" aria-label="메인 내비게이션">
  <a
    href="/"
    class="text-base font-semibold text-gray-900 dark:text-slate-100 hover:text-gray-600 dark:hover:text-slate-300 transition-colors"
    transition:name="site-logo"
  >
    장선규
  </a>

  <!-- 데스크톱 메뉴 -->
  <div class="hidden md:flex items-center gap-8">
    <ul class="flex items-center gap-8">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'text-sm transition-colors',
                isActive(item.href)
                  ? 'text-gray-900 dark:text-slate-100 font-medium'
                  : 'text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-100',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </div>

  <!-- 모바일: 토글 + 햄버거 -->
  <div class="flex md:hidden items-center gap-2">
    <ThemeToggle />
    <button
      type="button"
      class="mobile-menu-toggle flex flex-col justify-center items-center w-8 h-8 gap-1.5"
      aria-label="메뉴 열기"
      aria-expanded="false"
    >
      <span
        class="menu-bar block w-5 h-px bg-gray-900 dark:bg-slate-100 transition-all duration-200"
      ></span>
      <span
        class="menu-bar block w-5 h-px bg-gray-900 dark:bg-slate-100 transition-all duration-200"
      ></span>
    </button>
  </div>
</nav>

<!-- 모바일 메뉴 패널 -->
<div class="mobile-menu hidden md:hidden" aria-hidden="true">
  <ul class="flex flex-col gap-1 pt-4 pb-2">
    {
      NAV_ITEMS.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block py-2.5 text-sm transition-colors',
              isActive(item.href)
                ? 'text-gray-900 dark:text-slate-100 font-medium'
                : 'text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-100',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const updateThemeIcons = () => {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('.theme-icon-light').forEach((el) => {
      el.classList.toggle('hidden', !isDark);
    });
    document.querySelectorAll('.theme-icon-dark').forEach((el) => {
      el.classList.toggle('hidden', isDark);
    });
  };

  const initThemeToggle = () => {
    updateThemeIcons();

    document.querySelectorAll('.theme-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateThemeIcons();
      });
    });
  };

  const initMobileMenu = () => {
    const toggle = document.querySelector('.mobile-menu-toggle');
    const menu = document.querySelector('.mobile-menu');
    const bars = document.querySelectorAll('.menu-bar');

    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.contains('hidden');

      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? '메뉴 닫기' : '메뉴 열기');
      menu.setAttribute('aria-hidden', String(!isOpen));

      if (isOpen) {
        bars[0]?.classList.add('translate-y-[4px]', 'rotate-45');
        bars[1]?.classList.add('-translate-y-[4px]', '-rotate-45');
      } else {
        bars[0]?.classList.remove('translate-y-[4px]', 'rotate-45');
        bars[1]?.classList.remove('-translate-y-[4px]', '-rotate-45');
      }
    });
  };

  document.addEventListener('astro:page-load', () => {
    initThemeToggle();
    initMobileMenu();
  });
</script>
