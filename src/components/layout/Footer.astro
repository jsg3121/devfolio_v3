---
const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: 'GitHub', href: 'https://github.com/jsg3121', external: true },
  { label: 'Email', href: 'mailto:xodm95@gmail.com', external: false },
];
---

<footer class="border-t border-gray-100 dark:border-slate-800">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mb-1">sungyujang</p>
        <p class="text-xs text-gray-500 dark:text-slate-400">Frontend Engineer</p>
      </div>
      <nav aria-label="푸터 링크">
        <ul class="flex items-center gap-6">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-100 transition-colors"
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="text-xs text-gray-500 dark:text-slate-400 mt-8">
      &copy; {currentYear} sungyujang. All rights reserved.
    </p>
  </div>
</footer>
