---
import { Image } from 'astro:assets';
import chevronLeftLight from '@/assets/icons/chevron-left-light.svg';
import chevronLeftDark from '@/assets/icons/chevron-left-dark.svg';
import chevronRightLight from '@/assets/icons/chevron-right-light.svg';
import chevronRightDark from '@/assets/icons/chevron-right-dark.svg';
import closeLight from '@/assets/icons/close-light.svg';
import closeDark from '@/assets/icons/close-dark.svg';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;
const hasMultiple = images.length > 1;
---

{
  images.length > 0 && (
    <section class="mb-12 md:mb-16">
      <span class="w-full h-6 text-sm">* 이미지를 클릭하여 확대하실 수 있습니다.</span>
      <div class="image-slider relative">
        <div class="slider-track flex overflow-x-auto snap-x snap-mandatory scrollbar-hide">
          {images.map((image, index) => (
            <figure class="slider-slide w-full shrink-0 snap-center">
              <button
                type="button"
                class="slider-image-btn block w-full h-40 md:h-137.5 overflow-hidden rounded-lg border border-gray-200 dark:border-slate-700 cursor-zoom-in"
                data-image-index={index}
                aria-label={`${image.alt} 크게 보기`}
              >
                <Image
                  src={image.src}
                  alt={image.alt}
                  class="w-full h-full! object-cover"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </button>
            </figure>
          ))}
        </div>

        {hasMultiple && (
          <>
            <button
              type="button"
              class="slider-btn slider-btn--prev absolute top-1/2 left-2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/80 dark:bg-slate-800/80 border border-gray-200 dark:border-slate-600 flex items-center justify-center text-gray-600 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-700 transition-colors backdrop-blur-sm disabled:opacity-30 disabled:cursor-not-allowed"
              aria-label="이전 이미지"
              disabled
            >
              <Image src={chevronLeftLight} alt="" width={16} height={16} class="dark:hidden" />
              <Image
                src={chevronLeftDark}
                alt=""
                width={16}
                height={16}
                class="hidden dark:block"
              />
            </button>
            <button
              type="button"
              class="slider-btn slider-btn--next absolute top-1/2 right-2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/80 dark:bg-slate-800/80 border border-gray-200 dark:border-slate-600 flex items-center justify-center hover:bg-white dark:hover:bg-slate-700 transition-colors backdrop-blur-sm disabled:opacity-30 disabled:cursor-not-allowed"
              aria-label="다음 이미지"
            >
              <Image src={chevronRightLight} alt="" width={16} height={16} class="dark:hidden" />
              <Image
                src={chevronRightDark}
                alt=""
                width={16}
                height={16}
                class="hidden dark:block"
              />
            </button>

            <div class="slider-dots flex justify-center gap-1.5 mt-4">
              {images.map((_, index) => (
                <button
                  type="button"
                  class:list={[
                    'slider-dot w-2 h-2 rounded-full transition-colors',
                    index === 0 ? 'bg-gray-900 dark:bg-slate-100' : 'bg-gray-300 dark:bg-slate-600',
                  ]}
                  aria-label={`${index + 1}번째 이미지로 이동`}
                  data-index={index}
                />
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )
}

{
  images.length > 0 && (
    <div
      class="lightbox fixed inset-0 px-4 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-label="이미지 뷰어"
    >
      <button
        type="button"
        class="lightbox-close absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-white/20 transition-colors"
        aria-label="닫기"
      >
        <Image src={closeDark} alt="" width={20} height={20} />
      </button>

      {hasMultiple && (
        <>
          <button
            type="button"
            class="lightbox-prev absolute left-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-black/40 flex items-center justify-center hover:bg-white/20 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
            aria-label="이전 이미지"
          >
            <Image src={chevronLeftDark} alt="" width={20} height={20} />
          </button>
          <button
            type="button"
            class="lightbox-next absolute right-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-black/40 flex items-center justify-center hover:bg-white/20 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
            aria-label="다음 이미지"
          >
            <Image src={chevronRightDark} alt="" width={20} height={20} />
          </button>
        </>
      )}

      <img class="lightbox-image max-w-[90vw] max-h-[85vh] object-contain" src="" alt="" />

      {hasMultiple && (
        <span class="lightbox-counter absolute bottom-6 left-1/2 -translate-x-1/2 text-sm text-white/70" />
      )}
    </div>
  )
}

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const initSlider = () => {
    const sliders = document.querySelectorAll('.image-slider');

    sliders.forEach((slider) => {
      const track = slider.querySelector('.slider-track') as HTMLElement | null;
      const prevBtn = slider.querySelector('.slider-btn--prev') as HTMLButtonElement | null;
      const nextBtn = slider.querySelector('.slider-btn--next') as HTMLButtonElement | null;
      const dots = slider.querySelectorAll('.slider-dot');

      if (!track) return;

      const slides = track.querySelectorAll('.slider-slide');
      if (slides.length <= 1) return;

      let currentIndex = 0;

      const updateState = () => {
        if (prevBtn) prevBtn.disabled = currentIndex === 0;
        if (nextBtn) nextBtn.disabled = currentIndex === slides.length - 1;

        dots.forEach((dot, i) => {
          if (i === currentIndex) {
            dot.classList.remove('bg-gray-300', 'dark:bg-slate-600');
            dot.classList.add('bg-gray-900', 'dark:bg-slate-100');
          } else {
            dot.classList.remove('bg-gray-900', 'dark:bg-slate-100');
            dot.classList.add('bg-gray-300', 'dark:bg-slate-600');
          }
        });
      };

      const goTo = (index: number) => {
        currentIndex = Math.max(0, Math.min(index, slides.length - 1));
        const target = slides[currentIndex] as HTMLElement;
        track.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
        updateState();
      };

      prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));
      nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const index = Number((dot as HTMLElement).dataset.index);
          goTo(index);
        });
      });

      let scrollTimer: ReturnType<typeof setTimeout>;
      track.addEventListener('scrollend', () => {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          const trackRect = track.getBoundingClientRect();
          const centerX = trackRect.left + trackRect.width / 2;

          let closest = 0;
          let minDist = Infinity;
          slides.forEach((slide, i) => {
            const slideRect = slide.getBoundingClientRect();
            const slideCenterX = slideRect.left + slideRect.width / 2;
            const dist = Math.abs(slideCenterX - centerX);
            if (dist < minDist) {
              minDist = dist;
              closest = i;
            }
          });

          currentIndex = closest;
          updateState();
        }, 50);
      });
    });
  };

  const initLightbox = () => {
    const lightbox = document.querySelector('.lightbox') as HTMLElement | null;
    const lightboxImage = document.querySelector('.lightbox-image') as HTMLImageElement | null;
    const closeBtn = document.querySelector('.lightbox-close') as HTMLButtonElement | null;
    const prevBtn = document.querySelector('.lightbox-prev') as HTMLButtonElement | null;
    const nextBtn = document.querySelector('.lightbox-next') as HTMLButtonElement | null;
    const counter = document.querySelector('.lightbox-counter') as HTMLElement | null;

    if (!lightbox || !lightboxImage) return;

    const imageButtons = document.querySelectorAll('.slider-image-btn');
    const images: { src: string; alt: string }[] = [];
    imageButtons.forEach((btn) => {
      const img = btn.querySelector('img');
      if (img) images.push({ src: img.src, alt: img.alt });
    });

    let currentIndex = 0;

    const isOpen = () => !lightbox.classList.contains('hidden');

    const updateLightbox = () => {
      const image = images[currentIndex];
      lightboxImage.src = image.src;
      lightboxImage.alt = image.alt;
      if (prevBtn) prevBtn.disabled = currentIndex === 0;
      if (nextBtn) nextBtn.disabled = currentIndex === images.length - 1;
      if (counter) counter.textContent = `${currentIndex + 1} / ${images.length}`;
    };

    const open = (index: number) => {
      currentIndex = index;
      updateLightbox();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.classList.add('overflow-hidden');
    };

    const close = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
      lightboxImage.src = '';
    };

    const goTo = (index: number) => {
      currentIndex = Math.max(0, Math.min(index, images.length - 1));
      updateLightbox();
    };

    imageButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number((btn as HTMLElement).dataset.imageIndex);
        open(index);
      });
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') goTo(currentIndex - 1);
      if (e.key === 'ArrowRight') goTo(currentIndex + 1);
    });
  };

  initSlider();
  initLightbox();
  document.addEventListener('astro:after-swap', () => {
    initSlider();
    initLightbox();
  });
</script>
