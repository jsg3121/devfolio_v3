---
interface Props {
  label: string;
  variant?: 'category' | 'tech';
  size?: 'sm' | 'md';
}

const { label, variant = 'tech', size = 'sm' } = Astro.props;

const radiusClass = variant === 'category' ? 'tag--category' : 'tag--tech';
const sizeClass = size === 'md' ? 'tag--md' : 'tag--sm';
---

<span class:list={['tag', radiusClass, sizeClass]}>{label}</span>

<style>
  .tag {
    display: inline-block;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
  }

  .tag--sm {
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.125rem 0.5rem;
  }

  .tag--md {
    font-size: 0.875rem;
    line-height: 1.25rem;
    padding: 0.375rem 0.75rem;
  }

  .tag--category {
    border-radius: 9999px;
  }

  .tag--tech {
    border-radius: 0.25rem;
  }
</style>
